<?xml version="1.0" encoding="utf-8"?>
<!-- 클라우드 백업·기기 간 이전으로 사용자 확인 없이 내보내지 않는다. 백업은 설정의 JSON 내보내기로만 한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
