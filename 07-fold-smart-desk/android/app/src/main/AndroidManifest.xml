<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 네트워크·위치·연락처·캘린더 권한은 쓰지 않는다. -->
    <!-- 타이머 종료 알림. 사용자가 처음 타이머를 시작할 때만 묻고, 거절해도 앱 안 타이머는 동작한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 정확한 종료 시각 알림용. Android 14+에서는 기본 꺼짐이며 사용자가 설정에서 켤 때만 쓴다(없으면 지연 가능 알림). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 바로가기 앱 선택용. 전체 설치 앱 조회(QUERY_ALL_PACKAGES) 대신 런처 인텐트로 보이는 앱만. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- allowBackup=false: 사용자 확인 없이 클라우드 자동 백업으로 내보내지 않는다. 백업은 설정의 JSON 내보내기로만. -->
    <application
        android:name=".FoldDeskApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldSmartDesk">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 다른 앱에서 공유한 텍스트/URL을 새 메모 후보로 받는다(미리보기 후 저장). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".timer.TimerAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
